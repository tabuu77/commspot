# CommSpot server (installed in Step 1). Sandboxed: no root, read-only system,
# no new privileges, only the network families it needs.
[Unit]
Description=CommSpot server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=commspot
Group=commspot
WorkingDirectory=/opt/commspot
ExecStart=/opt/commspot/CommSpot.Server
EnvironmentFile=/etc/commspot/secrets.env
Environment=ASPNETCORE_URLS=http://127.0.0.1:5100
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Restart=on-failure
RestartSec=3

# Shared VPS: the Metal Covenant game servers come first.
MemoryMax=1G
CPUQuota=50%
TasksMax=256

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
ReadWritePaths=/var/lib/commspot
UMask=0077

[Install]
WantedBy=multi-user.target
