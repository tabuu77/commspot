<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CommSpot.Client.MainWindow"
        Title="The Comm-Spot" Width="480" Height="820" MinWidth="380" MinHeight="600"
        Background="#000000">
  <Window.Styles>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="26"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="#A6A6A6"/>
      <Setter Property="Margin" Value="0,10,0,4"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#262626"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="0,10"/>
    </Style>
  </Window.Styles>

  <Grid Margin="20" RowDefinitions="Auto,*,Auto">
    <StackPanel Grid.Row="0" Spacing="2">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Classes="h1" Text="The Comm-Spot"/>
          <TextBlock Foreground="#7A7A7A" Text="Pull up a stool."/>
        </StackPanel>
        <Button Grid.Column="1" x:Name="SettingsButton" Content="⚙ Settings" VerticalAlignment="Top"/>
      </Grid>
      <Button x:Name="UpdateButton" Classes="primary" IsVisible="False" Margin="0,10,0,0" Background="#FFFFFF" Foreground="#000000"/>
    </StackPanel>

    <!-- Sign-in -->
    <ScrollViewer Grid.Row="1" x:Name="JoinPanel" Margin="0,16,0,0">
      <StackPanel>
        <TextBlock Classes="label" Text="Your name"/>
        <TextBox x:Name="NameBox" MaxLength="32" PlaceholderText="1-32 letters or numbers"/>
        <TextBlock Classes="label" Text="Access key"/>
        <TextBox x:Name="KeyBox" PasswordChar="●" RevealPassword="False"/>
        <Button x:Name="JoinButton" Classes="primary" Margin="0,20,0,0" Content="Join"/>
      </StackPanel>
    </ScrollViewer>

    <!-- In the room -->
    <Grid Grid.Row="1" x:Name="RoomPanel" IsVisible="False" Margin="0,16,0,0" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
      <TextBlock Grid.Row="0" Classes="label" Margin="0,0,0,8" Text="At the bar"/>
      <Border Grid.Row="1" Background="#141414" CornerRadius="8" Padding="12" MinHeight="60" MaxHeight="170">
        <ScrollViewer>
          <StackPanel x:Name="MemberList" Spacing="8"/>
        </ScrollViewer>
      </Border>
      <!-- What you're streaming, so you can see you're live. -->
      <Border Grid.Row="2" x:Name="PreviewPanel" IsVisible="False" Background="#141414" CornerRadius="8" Padding="10" Margin="0,10,0,0">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Background="#D64545" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
              <TextBlock Text="LIVE" FontSize="11" FontWeight="Bold" Foreground="White"/>
            </Border>
            <TextBlock x:Name="PreviewLabel" Foreground="#EDEDED" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <Image x:Name="PreviewImage" Height="150" Stretch="Uniform"/>
        </StackPanel>
      </Border>
      <ContentControl Grid.Row="3" x:Name="RoomChatHost" Margin="0,10,0,0" MinHeight="160"/>
      <TextBlock Grid.Row="4" x:Name="ModeHint" Foreground="#7A7A7A" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
      <Grid Grid.Row="5" ColumnDefinitions="*,8,*,8,*" RowDefinitions="Auto,8,Auto" Margin="0,12,0,0">
        <Button Grid.Row="0" Grid.ColumnSpan="5" x:Name="ShareButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Share Screen"/>
        <Button Grid.Row="2" Grid.Column="0" x:Name="MuteButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Mute"/>
        <Button Grid.Row="2" Grid.Column="2" x:Name="DeafenButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Deafen"/>
        <Button Grid.Row="2" Grid.Column="4" x:Name="LeaveButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Leave"/>
      </Grid>
    </Grid>

    <TextBlock Grid.Row="2" x:Name="StatusText" Margin="0,12,0,0" Foreground="#E07A5F" TextWrapping="Wrap"/>
  </Grid>
</Window>
