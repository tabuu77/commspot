<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>CommSpot</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\CommSpot.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="PortAudioSharp2" Version="1.0.6" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\CommSpot.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CommSpot.Client.Core\CommSpot.Client.Core.csproj" />
  </ItemGroup>
</Project>
